# ─── Database ─────────────────────────────────────────────────────────────
# REQUIRED. Postgres connection string.
#
# The ops platform lives in its own "ops" schema, isolated from the marketing
# site's `public` tables. Append `?schema=ops` and the app will set it on every
# connection — see the note in src/lib/prisma.ts about why the schema has to be
# passed to the driver adapter as well.
#
# sslmode=verify-full, not "require": on pg 8 / pg-connection-string 2.x the
# "require" alias logs a Node deprecation warning on every boot, and the
# suggested `uselibpqcompat=true` workaround would silently *downgrade* to
# rejectUnauthorized:false. verify-full behaves identically to what "require"
# does today (Node's default certificate verification) and stays warning-free.
#
# For production, point this at a dedicated database rather than sharing the
# marketing project's project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&schema=ops"

# ─── Auth (NextAuth / Auth.js) ────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Absolute origin of this deployment, used for check-in QR codes and email
# links. REQUIRED in production — the app throws at render time without it.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# Event name shown in the UI and used as the email subject prefix.
NEXT_PUBLIC_EVENT_NAME="TechSiege"

# Reply-to for outbound mail.
SUPPORT_EMAIL="cynex.depticb@gmail.com"

# ─── Transactional email
# Outbound mail goes over SMTP via nodemailer — the only transport. A hosted
# email API will only send from a domain you have verified, and a consumer
# mailbox like gmail.com can never be one, so it would reject the From address
# and deliver nothing. Gmail's own SMTP server sends from the real account to
# any recipient.
#
# Google requires an *app password*, not the account password:
#   1. Turn on 2-Step Verification at myaccount.google.com/security
#   2. Create an app password at myaccount.google.com/apppasswords
#      (name it anything, e.g. "techsiege-ops"; you get 16 characters)
#
# Leave SMTP_PASSWORD empty to log emails to the console instead of sending.
# Gmail caps a normal account at roughly 500 messages a day.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="cynex.depticb@gmail.com"
SMTP_PASSWORD=""
EMAIL_FROM="TechSiege <cynex.depticb@gmail.com>"

# ─── Optional: Google OAuth ───────────────────────────────────────────────
# The Google provider is only registered when BOTH are set, so leaving these
# blank cleanly disables it. Staff are still created with email + password.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
